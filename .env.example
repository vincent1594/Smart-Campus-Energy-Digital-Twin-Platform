# docker compose 環境變數範本 —— 複製成 .env 後填值(.env 已被 gitignore,勿提交)
#   cp .env.example .env

# Postgres 密碼(正式 server 請務必改掉,別用預設)
POSTGRES_PASSWORD=change-me-in-production

# 前端對外 port(預設 10600;要直接吃 80 可改 80)
WEB_PORT=10600

# 後端 API 對外 port(預設 10601)
API_PORT=10601

# 前端 build 模式:根路徑部署留空/docker;部署到 IIS 的 /MEN/ 子路徑時設 men
# WEB_BUILD_MODE=men
